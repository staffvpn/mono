# ============================================================
# Переменные окружения TEYDO
# Файл .env в репозиторий не коммитится. На хостинге значения
# задаются в настройках проекта (Vercel → Settings → Environment Variables).
# ============================================================

# ---------- Клиент (видно в браузере, секретов быть не должно) ----------

# true  — весь слой данных работает на моках в localStorage (по умолчанию)
# false — сервисы уходят по HTTP в NEXT_PUBLIC_API_URL
NEXT_PUBLIC_USE_MOCK_DATA=true

# База API. Пусто = свои маршруты /api того же домена.
NEXT_PUBLIC_API_URL=

# Имя бота без @ — для ссылок t.me и Login Widget
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=teydobot

# ---------- Сервер (в браузер не попадает) ----------

# Токен бота из @BotFather. Даёт полный доступ к боту — не коммитить,
# не пересылать в переписке, при утечке отзывать через /revoke.
BOT_TOKEN=

# Секрет для подписи сессионной куки. Минимум 16 символов,
# сгенерировать: openssl rand -hex 32
SESSION_SECRET=

# ---------- SMS (не подключено) ----------
# Пока переменная пуста, вход по номеру телефона отключён,
# а /api/auth/phone/* честно отвечает 501.
SMS_PROVIDER=
SMS_API_KEY=

# ---------- Платежи (не подключено) ----------
# Пока не заданы, экраны оплаты работают в демонстрационном режиме
# и настоящих списаний не происходит.
PAYMENT_PROVIDER=
PAYMENT_SHOP_ID=
PAYMENT_SECRET_KEY=

# ---------- База данных (не подключена) ----------
DATABASE_URL=
